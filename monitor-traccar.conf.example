; Credenciais do usuário do Traccar usadas no teste de login REAL.
; Local no servidor: /etc/monitor-traccar.conf  (fora do docroot, dono root, chmod 600)
;   cp monitor-traccar.conf.example /etc/monitor-traccar.conf && chmod 600 /etc/monitor-traccar.conf
; Sem este arquivo o monitor continua rodando, mas pula o teste de login
; (e registra isso no log, para não ficar cego sem avisar).
usuario = seu_usuario_traccar
senha   = sua_senha_traccar

; IP REAL do servidor de origem (opcional, mas é o que fecha a causa raiz).
; Com ele, ao confirmar uma falha o monitor repete a requisição resolvendo o
; domínio direto nesse IP — furando a Cloudflare, com o mesmo Host e SNI. Se a
; origem responde e a borda não, a falha está na Cloudflare/rota; se nenhuma
; responde, o problema é o servidor. Sem este campo o veredito fica
; "indeterminado" e o painel não afirma nada que não tenha verificado.
origem_ip = 203.0.113.10
